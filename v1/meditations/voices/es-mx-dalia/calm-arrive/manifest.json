{
  "id": "calm-arrive",
  "voiceId": "es-mx-dalia",
  "edgeVoice": "es-MX-DaliaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 109,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "Tómate un momento para llegar.",
      "file": "c001.ogg",
      "durationSec": 4.56
    },
    {
      "index": 2,
      "text": "Busque un asiento cómodo o acuéstese si se siente mejor.",
      "file": "c002.ogg",
      "durationSec": 7.224
    },
    {
      "index": 3,
      "text": "Deja que tus manos descansen.",
      "file": "c003.ogg",
      "durationSec": 4.536
    },
    {
      "index": 4,
      "text": "Deja que tus ojos se cierren o suaviza tu mirada.",
      "file": "c004.ogg",
      "durationSec": 6.264
    },
    {
      "index": 5,
      "text": "Fíjate que estás aquí.",
      "file": "c005.ogg",
      "durationSec": 3.864
    },
    {
      "index": 6,
      "text": "No hay nada que arreglar ahora.",
      "file": "c006.ogg",
      "durationSec": 4.608
    },
    {
      "index": 7,
      "text": "Nada que completar.",
      "file": "c007.ogg",
      "durationSec": 3.744
    },
    {
      "index": 8,
      "text": "Respire lentamente por la nariz.",
      "file": "c008.ogg",
      "durationSec": 5.088
    },
    {
      "index": 9,
      "text": "Y una exhalación más larga.",
      "file": "c009.ogg",
      "durationSec": 4.488
    },
    {
      "index": 10,
      "text": "De nuevo. Inhala suavemente.",
      "file": "c010.ogg",
      "durationSec": 6.576
    },
    {
      "index": 11,
      "text": "Exhala suavemente.",
      "file": "c011.ogg",
      "durationSec": 3.984
    },
    {
      "index": 12,
      "text": "Siente el peso de tu cuerpo apoyado.",
      "file": "c012.ogg",
      "durationSec": 5.232
    },
    {
      "index": 13,
      "text": "El suelo, la silla, la tierra que te sostiene.",
      "file": "c013.ogg",
      "durationSec": 7.056
    },
    {
      "index": 14,
      "text": "Si los pensamientos divagan, está bien.",
      "file": "c014.ogg",
      "durationSec": 5.712
    },
    {
      "index": 15,
      "text": "Simplemente observa y regresa a esta respiración.",
      "file": "c015.ogg",
      "durationSec": 6.576
    },
    {
      "index": 16,
      "text": "Inhalar. Llegar.",
      "file": "c016.ogg",
      "durationSec": 5.328
    },
    {
      "index": 17,
      "text": "Exhalar. Asentarse.",
      "file": "c017.ogg",
      "durationSec": 5.976
    },
    {
      "index": 18,
      "text": "Un respiro más tranquilo.",
      "file": "c018.ogg",
      "durationSec": 4.296
    },
    {
      "index": 19,
      "text": "Cuando estés listo, abre los ojos.",
      "file": "c019.ogg",
      "durationSec": 5.52
    },
    {
      "index": 20,
      "text": "Lleva este silencio contigo.",
      "file": "c020.ogg",
      "durationSec": 4.704
    }
  ]
}
