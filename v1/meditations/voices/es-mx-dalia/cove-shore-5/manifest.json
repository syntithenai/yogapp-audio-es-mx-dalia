{
  "id": "cove-shore-5",
  "voiceId": "es-mx-dalia",
  "edgeVoice": "es-MX-DaliaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 370,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "Tome un asiento cómodo o acuéstese si se siente mejor.",
      "file": "c001.ogg",
      "durationSec": 7.032
    },
    {
      "index": 2,
      "text": "Deja que tus manos descansen.",
      "file": "c002.ogg",
      "durationSec": 4.536
    },
    {
      "index": 3,
      "text": "Deja que tus ojos se cierren o suaviza tu mirada.",
      "file": "c003.ogg",
      "durationSec": 6.264
    },
    {
      "index": 4,
      "text": "Observe el peso de su cuerpo que se sostiene.",
      "file": "c004.ogg",
      "durationSec": 5.784
    },
    {
      "index": 5,
      "text": "Respire lentamente por la nariz.",
      "file": "c005.ogg",
      "durationSec": 5.088
    },
    {
      "index": 6,
      "text": "Y una exhalación más larga y más fácil.",
      "file": "c006.ogg",
      "durationSec": 5.64
    },
    {
      "index": 7,
      "text": "De nuevo. Inhala suavemente.",
      "file": "c007.ogg",
      "durationSec": 6.576
    },
    {
      "index": 8,
      "text": "Exhala suavemente.",
      "file": "c008.ogg",
      "durationSec": 3.984
    },
    {
      "index": 9,
      "text": "Si los pensamientos divagan, está bien. Vuelve a la respiración.",
      "file": "c009.ogg",
      "durationSec": 9.504
    },
    {
      "index": 10,
      "text": "Imagínese llegar a una cala protegida.",
      "file": "c010.ogg",
      "durationSec": 5.616
    },
    {
      "index": 11,
      "text": "Los acantilados se curvan alrededor de arena suave y pálida.",
      "file": "c011.ogg",
      "durationSec": 7.416
    },
    {
      "index": 12,
      "text": "El mar se mueve en olas bajas y pacientes.",
      "file": "c012.ogg",
      "durationSec": 5.928
    },
    {
      "index": 13,
      "text": "Un sol suave calienta la parte superior de tus hombros.",
      "file": "c013.ogg",
      "durationSec": 6.936
    },
    {
      "index": 14,
      "text": "Una brisa salada refresca tus labios y párpados.",
      "file": "c014.ogg",
      "durationSec": 6.672
    },
    {
      "index": 15,
      "text": "Siente la frescura de ese aire llenando tu pecho.",
      "file": "c015.ogg",
      "durationSec": 6.432
    },
    {
      "index": 16,
      "text": "Camine hasta la línea de flotación. La arena mojada abraza tus pies.",
      "file": "c016.ogg",
      "durationSec": 10.2
    },
    {
      "index": 17,
      "text": "La espuma fría toca tus tobillos y se desliza.",
      "file": "c017.ogg",
      "durationSec": 6.24
    },
    {
      "index": 18,
      "text": "El ritmo es simple. Llegar. Ablandar. Dejar.",
      "file": "c018.ogg",
      "durationSec": 11.496
    },
    {
      "index": 19,
      "text": "Siéntate donde la arena seca esté cálida debajo de ti.",
      "file": "c019.ogg",
      "durationSec": 6.912
    },
    {
      "index": 20,
      "text": "Recuéstate sobre tus manos. Siente el calor granulado.",
      "file": "c020.ogg",
      "durationSec": 9.168
    },
    {
      "index": 21,
      "text": "Escuche el silencio y el bullicio de la cala.",
      "file": "c021.ogg",
      "durationSec": 6.0
    },
    {
      "index": 22,
      "text": "Huele a sal, a sol y a piedra limpia.",
      "file": "c022.ogg",
      "durationSec": 5.64
    },
    {
      "index": 23,
      "text": "Calidez en tu piel. Frescor en cada inhalación.",
      "file": "c023.ogg",
      "durationSec": 7.992
    },
    {
      "index": 24,
      "text": "A lo lejos, la luz brilla como una risa silenciosa.",
      "file": "c024.ogg",
      "durationSec": 7.248
    },
    {
      "index": 25,
      "text": "No es necesario que lo persigas. Ya está aquí.",
      "file": "c025.ogg",
      "durationSec": 8.136
    },
    {
      "index": 26,
      "text": "Una ola llega más lejos, refresca los dedos de los pies y luego retrocede.",
      "file": "c026.ogg",
      "durationSec": 9.456
    },
    {
      "index": 27,
      "text": "La arena cálida recupera tus pies.",
      "file": "c027.ogg",
      "durationSec": 5.376
    },
    {
      "index": 28,
      "text": "Deje que su respiración se mueva con las olas: inhalando lentamente, exhalando más tiempo.",
      "file": "c028.ogg",
      "durationSec": 11.064
    },
    {
      "index": 29,
      "text": "La paz es la cala misma. Estás dentro de él.",
      "file": "c029.ogg",
      "durationSec": 8.016
    },
    {
      "index": 30,
      "text": "Descanse su atención en el calor entre sus omóplatos.",
      "file": "c030.ogg",
      "durationSec": 6.696
    },
    {
      "index": 31,
      "text": "Y en el aire fresco y salado en la punta de la nariz.",
      "file": "c031.ogg",
      "durationSec": 6.744
    },
    {
      "index": 32,
      "text": "Traza la línea del acantilado con suave imaginación.",
      "file": "c032.ogg",
      "durationSec": 6.744
    },
    {
      "index": 33,
      "text": "Piedra calentada durante el día. Sombra fresca en los pliegues.",
      "file": "c033.ogg",
      "durationSec": 9.168
    },
    {
      "index": 34,
      "text": "Una piscina de marea cercana contiene un pequeño mundo claro.",
      "file": "c034.ogg",
      "durationSec": 7.344
    },
    {
      "index": 35,
      "text": "No es necesario que te inclines. Saber que está ahí es suficiente.",
      "file": "c035.ogg",
      "durationSec": 9.72
    },
    {
      "index": 36,
      "text": "Otra ola. Tobillos frescos. Arena cálida. Aliento suave.",
      "file": "c036.ogg",
      "durationSec": 13.416
    },
    {
      "index": 37,
      "text": "La cala sigue ofreciendo la misma amabilidad sencilla.",
      "file": "c037.ogg",
      "durationSec": 6.984
    },
    {
      "index": 38,
      "text": "Recíbelo una vez más antes de partir.",
      "file": "c038.ogg",
      "durationSec": 5.496
    },
    {
      "index": 39,
      "text": "Ahora descansa un rato en la respiración a solas.",
      "file": "c039.ogg",
      "durationSec": 6.432
    },
    {
      "index": 40,
      "text": "Inhala lentamente.",
      "file": "c040.ogg",
      "durationSec": 4.032
    },
    {
      "index": 41,
      "text": "Exhala lentamente.",
      "file": "c041.ogg",
      "durationSec": 4.128
    },
    {
      "index": 42,
      "text": "Inhalar.",
      "file": "c042.ogg",
      "durationSec": 2.808
    },
    {
      "index": 43,
      "text": "Exhalar.",
      "file": "c043.ogg",
      "durationSec": 3.0
    },
    {
      "index": 44,
      "text": "Siente calidez dondequiera que el cuerpo esté caliente.",
      "file": "c044.ogg",
      "durationSec": 6.504
    },
    {
      "index": 45,
      "text": "Siente frescura dondequiera que el aire esté fresco.",
      "file": "c045.ogg",
      "durationSec": 6.48
    },
    {
      "index": 46,
      "text": "Inhalar.",
      "file": "c046.ogg",
      "durationSec": 2.808
    },
    {
      "index": 47,
      "text": "Exhalar.",
      "file": "c047.ogg",
      "durationSec": 3.0
    },
    {
      "index": 48,
      "text": "Ningún lugar adonde ir. Nada que arreglar.",
      "file": "c048.ogg",
      "durationSec": 7.608
    },
    {
      "index": 49,
      "text": "Inhalar.",
      "file": "c049.ogg",
      "durationSec": 2.808
    },
    {
      "index": 50,
      "text": "Exhalar.",
      "file": "c050.ogg",
      "durationSec": 3.0
    },
    {
      "index": 51,
      "text": "Descanse aquí durante unas cuantas respiraciones tranquilas.",
      "file": "c051.ogg",
      "durationSec": 7.464
    },
    {
      "index": 52,
      "text": "Sepa que puede regresar a este lugar en cualquier momento.",
      "file": "c052.ogg",
      "durationSec": 6.576
    },
    {
      "index": 53,
      "text": "Cuando estés listo, profundiza la respiración.",
      "file": "c053.ogg",
      "durationSec": 6.288
    },
    {
      "index": 54,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c054.ogg",
      "durationSec": 5.568
    },
    {
      "index": 55,
      "text": "Abre los ojos suavemente.",
      "file": "c055.ogg",
      "durationSec": 4.416
    },
    {
      "index": 56,
      "text": "Lleva un poco de esta paz contigo.",
      "file": "c056.ogg",
      "durationSec": 5.112
    }
  ]
}
