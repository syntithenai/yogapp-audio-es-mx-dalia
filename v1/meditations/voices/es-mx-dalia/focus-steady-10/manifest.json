  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "Tómese el tiempo para llegar.",
      "file": "c001.ogg",
      "durationSec": 4.272
    },
    {
      "index": 2,
      "text": "Siéntate o acuéstate con apoyo.",
      "file": "c002.ogg",
      "durationSec": 5.232
    },
    {
      "index": 3,
      "text": "Cierra los ojos si te sientes seguro.",
      "file": "c003.ogg",
      "durationSec": 5.136
    },
    {
      "index": 4,
      "text": "Siente el contacto con el suelo.",
      "file": "c004.ogg",
      "durationSec": 4.536
    },
    {
      "index": 5,
      "text": "Inhale lentamente.",
      "file": "c005.ogg",
      "durationSec": 3.984
    },
    {
      "index": 6,
      "text": "Exhale más tiempo.",
      "file": "c006.ogg",
      "durationSec": 3.888
    },
    {
      "index": 7,
      "text": "[pausa:21]",
      "file": "c007.ogg",
      "durationSec": 4.008
    },
    {
      "index": 8,
      "text": "De nuevo.",
      "file": "c008.ogg",
      "durationSec": 2.808
    },
    {
      "index": 9,
      "text": "[pausa:21]",
      "file": "c009.ogg",
      "durationSec": 4.008
    },
    {
      "index": 10,
      "text": "Deja caer los hombros.",
      "file": "c010.ogg",
      "durationSec": 4.128
    },
    {
      "index": 11,
      "text": "Deja que la barriga se ablande.",
      "file": "c011.ogg",
      "durationSec": 4.488
    },
    {
      "index": 12,
      "text": "[pausa:26]",
      "file": "c012.ogg",
      "durationSec": 4.248
    },
    {
      "index": 13,
      "text": "Elige la respiración en las fosas nasales como tu punto.",
      "file": "c013.ogg",
      "durationSec": 6.84
    },
    {
      "index": 14,
      "text": "Quédate con la sensación del aire.",
      "file": "c014.ogg",
      "durationSec": 4.704
    },
    {
      "index": 15,
      "text": "[pausa:26]",
      "file": "c015.ogg",
      "durationSec": 4.248
    },
    {
      "index": 16,
      "text": "Cuente cada exhalación del uno al diez.",
      "file": "c016.ogg",
      "durationSec": 5.4
    },
    {
      "index": 17,
      "text": "Si pierdes la cuenta, comienza de nuevo desde uno sin culpa.",
      "file": "c017.ogg",
      "durationSec": 7.944
    },
    {
      "index": 18,
      "text": "[pausa:21]",
      "file": "c018.ogg",
      "durationSec": 4.008
    },
    {
      "index": 19,
      "text": "Uno.",
      "file": "c019.ogg",
      "durationSec": 2.448
    },
    {
      "index": 20,
      "text": "[pausa:21]",
      "file": "c020.ogg",
      "durationSec": 4.008
    },
    {
      "index": 21,
      "text": "Dos.",
      "file": "c021.ogg",
      "durationSec": 2.568
    },
    {
      "index": 22,
      "text": "[pausa:21]",
      "file": "c022.ogg",
      "durationSec": 4.008
    },
    {
      "index": 23,
      "text": "Tres.",
      "file": "c023.ogg",
      "durationSec": 2.568
    },
    {
      "index": 24,
      "text": "[pausa:21]",
      "file": "c024.ogg",
      "durationSec": 4.008
    },
    {
      "index": 25,
      "text": "Cuatro.",
      "file": "c025.ogg",
      "durationSec": 2.496
    },
    {
      "index": 26,
      "text": "[pausa:21]",
      "file": "c026.ogg",
      "durationSec": 4.008
    },
    {
      "index": 27,
      "text": "Cinco.",
      "file": "c027.ogg",
      "durationSec": 2.736
    },
    {
      "index": 28,
      "text": "[pausa:21]",
      "file": "c028.ogg",
      "durationSec": 4.008
    },
    {
      "index": 29,
      "text": "Continúe en silencio hasta el diez y luego comience en el uno.",
      "file": "c029.ogg",
      "durationSec": 7.2
    },
    {
      "index": 30,
      "text": "[pausa:90]",
      "file": "c030.ogg",
      "durationSec": 4.224
    },
    {
      "index": 31,
      "text": "Liberar el conteo.",
      "file": "c031.ogg",
      "durationSec": 3.6
    },
    {
      "index": 32,
      "text": "Descanse con total atención en la respiración.",
      "file": "c032.ogg",
      "durationSec": 6.024
    },
    {
      "index": 33,
      "text": "[pausa:79]",
      "file": "c033.ogg",
      "durationSec": 4.608
    },
    {
      "index": 34,
      "text": "Claridad sin dureza.",
      "file": "c034.ogg",
      "durationSec": 3.864
    },
    {
      "index": 35,
      "text": "[pausa:42]",
      "file": "c035.ogg",
      "durationSec": 4.536
    },
    {
      "index": 36,
      "text": "[pausa:32]",
      "file": "c036.ogg",
      "durationSec": 4.296
    },
    {
      "index": 37,
      "text": "Comience a profundizar la respiración.",
      "file": "c037.ogg",
      "durationSec": 5.304
    },
    {
      "index": 38,
      "text": "Descansa aquí.",
      "file": "c038.ogg",
      "durationSec": 3.456
    },
    {
      "index": 39,
      "text": "[pausa:44]",
      "file": "c039.ogg",
      "durationSec": 4.584
    },
    {
      "index": 40,
      "text": "Siente la habitación de nuevo.",
      "file": "c040.ogg",
      "durationSec": 4.464
    },
    {
      "index": 41,
      "text": "Mueve los dedos de las manos y de los pies.",
      "file": "c041.ogg",
      "durationSec": 5.568
    },
    {
      "index": 42,
      "text": "Cuando esté listo, abre los ojos.",
      "file": "c042.ogg",
      "durationSec": 5.376
    },
    {
      "index": 43,
      "text": "Avance lentamente hacia lo que viene a continuación.",
      "file": "c043.ogg",
      "durationSec": 6.456
