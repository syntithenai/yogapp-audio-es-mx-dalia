    {
      "index": 22,
      "text": "Que estés tranquilo.",
      "file": "c022.ogg",
      "durationSec": 3.552
    },
    {
      "index": 23,
      "text": "Siente cualquier calidez que surja. O simplemente descansar en las palabras.",
      "file": "c023.ogg",
      "durationSec": 10.248
