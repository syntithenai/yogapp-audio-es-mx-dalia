  "chunks": [
    {
      "index": 0,
      "text": "Siéntate cómodamente. Suaviza el rostro.",
      "file": "c000.ogg",
      "durationSec": 7.656
    },
    {
      "index": 1,
      "text": "Coloque una mano sobre el corazón si eso ayuda.",
      "file": "c001.ogg",
      "durationSec": 6.192
    },
    {
      "index": 2,
      "text": "Ofreceremos frases sencillas de bondad.",
      "file": "c002.ogg",
      "durationSec": 5.352
    },
    {
      "index": 3,
      "text": "Primero, hacia ti mismo.",
      "file": "c003.ogg",
      "durationSec": 4.8
    },
    {
      "index": 4,
      "text": "Repite en silencio conmigo o simplemente escucha.",
      "file": "c004.ogg",
      "durationSec": 6.696
    },
    {
      "index": 5,
      "text": "¿Puedo estar a salvo?",
      "file": "c005.ogg",
      "durationSec": 3.48
    },
    {
      "index": 6,
      "text": "Que esté bien.",
      "file": "c006.ogg",
      "durationSec": 3.12
    },
    {
      "index": 7,
      "text": "Que pueda estar tranquilo.",
      "file": "c007.ogg",
      "durationSec": 4.104
    },
    {
      "index": 8,
      "text": "Dígalas de nuevo, lentamente.",
      "file": "c008.ogg",
      "durationSec": 5.112
    },
    {
      "index": 9,
      "text": "¿Puedo estar a salvo?",
      "file": "c009.ogg",
      "durationSec": 3.48
    },
    {
      "index": 10,
      "text": "Que esté bien.",
      "file": "c010.ogg",
      "durationSec": 3.12
    },
    {
      "index": 11,
      "text": "Que pueda estar tranquilo.",
      "file": "c011.ogg",
      "durationSec": 4.104
    },
    {
      "index": 12,
      "text": "Si eso le resulta difícil, está bien. Quédate con el deseo mismo.",
      "file": "c012.ogg",
      "durationSec": 10.224
    },
    {
      "index": 13,
      "text": "Ahora piense en alguien por quien sea fácil preocuparse.",
      "file": "c013.ogg",
      "durationSec": 6.72
    },
    {
      "index": 14,
      "text": "Un amigo, una mascota, un amable extraño.",
      "file": "c014.ogg",
      "durationSec": 6.72
    },
    {
      "index": 15,
      "text": "Imagínelos brevemente.",
      "file": "c015.ogg",
      "durationSec": 4.32
    },
    {
      "index": 16,
      "text": "Que estés a salvo.",
      "file": "c016.ogg",
      "durationSec": 3.576
    },
    {
      "index": 17,
      "text": "Que estés bien.",
      "file": "c017.ogg",
      "durationSec": 3.072
    },
    {
      "index": 18,
      "text": "Que estés tranquilo.",
      "file": "c018.ogg",
      "durationSec": 3.552
    },
    {
      "index": 19,
      "text": "Una vez más.",
      "file": "c019.ogg",
      "durationSec": 3.288
    },
    {
      "index": 20,
      "text": "Que estés a salvo.",
      "file": "c020.ogg",
      "durationSec": 3.576
    },
    {
      "index": 21,
      "text": "Que estés bien.",
      "file": "c021.ogg",
      "durationSec": 3.072
