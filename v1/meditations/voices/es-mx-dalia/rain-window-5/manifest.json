  "totalSec": 137,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "Busque un asiento cómodo o acuéstese si se siente mejor.",
      "file": "c001.ogg",
      "durationSec": 7.224
    },
    {
      "index": 2,
      "text": "Deja descansar las manos.",
      "file": "c002.ogg",
      "durationSec": 4.584
    },
    {
      "index": 3,
      "text": "Suaviza los ojos o ciérralos.",
      "file": "c003.ogg",
      "durationSec": 4.992
    },
    {
      "index": 4,
      "text": "Respire lentamente.",
      "file": "c004.ogg",
      "durationSec": 4.104
    },
    {
      "index": 5,
      "text": "Y una exhalación más larga.",
      "file": "c005.ogg",
      "durationSec": 4.488
    },
    {
      "index": 6,
      "text": "Imagínese sentado junto a una ventana en un tranquilo día lluvioso.",
      "file": "c006.ogg",
      "durationSec": 8.208
    },
    {
      "index": 7,
      "text": "Vidrio genial. Mundo suave afuera.",
      "file": "c007.ogg",
      "durationSec": 7.176
    },
    {
      "index": 8,
      "text": "[pausa:30]",
      "file": "c008.ogg",
      "durationSec": 3.96
    },
    {
      "index": 9,
      "text": "Escuche la lluvia sin necesidad de una historia.",
      "file": "c009.ogg",
      "durationSec": 6.24
    },
    {
      "index": 10,
      "text": "Pequeños grifos. Caídas ocasionales más fuertes.",
      "file": "c010.ogg",
      "durationSec": 8.592
    },
    {
      "index": 11,
      "text": "[pausa:36]",
      "file": "c011.ogg",
      "durationSec": 4.344
    },
    {
      "index": 12,
      "text": "Huele a aire limpio y húmedo.",
      "file": "c012.ogg",
      "durationSec": 4.512
    },
    {
      "index": 13,
      "text": "Ver luz gris, suave y pausada.",
      "file": "c013.ogg",
      "durationSec": 5.592
    },
    {
      "index": 14,
      "text": "[pausa:30]",
      "file": "c014.ogg",
      "durationSec": 3.96
    },
    {
      "index": 15,
      "text": "No hay ningún lugar adonde ir bajo la lluvia.",
      "file": "c015.ogg",
      "durationSec": 5.736
    },
    {
      "index": 16,
      "text": "Permiso para pausar.",
      "file": "c016.ogg",
      "durationSec": 3.888
    },
    {
      "index": 17,
      "text": "[pausa:36]",
      "file": "c017.ogg",
      "durationSec": 4.344
    },
    {
      "index": 18,
      "text": "Respira con el ritmo del agua sobre el vaso.",
      "file": "c018.ogg",
      "durationSec": 5.736
    },
    {
      "index": 19,
      "text": "[pausa:45]",
      "file": "c019.ogg",
      "durationSec": 4.656
    },
    {
      "index": 20,
      "text": "Deje que el sistema nervioso siga el ejemplo: ablandese.",
      "file": "c020.ogg",
      "durationSec": 7.632
    },
    {
      "index": 21,
      "text": "[pausa:36]",
      "file": "c021.ogg",
      "durationSec": 4.344
    },
    {
      "index": 22,
      "text": "Respira tranquilamente una vez más.",
      "file": "c022.ogg",
      "durationSec": 5.592
    },
    {
      "index": 23,
      "text": "Mueve los dedos.",
      "file": "c023.ogg",
      "durationSec": 3.672
    },
    {
      "index": 24,
      "text": "Cuando estés listo, abre los ojos.",
      "file": "c024.ogg",
      "durationSec": 5.52
    },
    {
      "index": 25,
      "text": "Lleva un poco de esto contigo.",
      "file": "c025.ogg",
      "durationSec": 4.824
    }
  ]
}
